#!/bin/sh
# Brings the serving container's site up, in the background of the entrypoint.
#
#  - first boot: installs the site on an empty database, the code path
#    `openkb-install` runs,
#  - an image update that left database updates pending: holds the site until
#    an administrator has run update.php. Updates never run from here.
#
# Caddy answers every request with the setup page while `.openkb-holding`
# exists. That marker is this container's own — only Caddy and this script read
# it — so it lives in /run and not on the shared files volume, which carries the
# site's private data. The lock does have to be shared: it makes one boot at a
# time run across the containers on that volume. site-install.sh writes the
# install markers on that volume:
#  - `.openkb-installed`: the install finished,
#  - `.openkb-installing`: an install started and did not finish, so the next
#    boot installs over what it left in the database.
# A non-empty database with neither marker is not this stack's site: the boot
# installs nothing and the setup page stays up.
cd /app || exit 1

FILES_DIR=${PERSISTENT_FILES_DIR:-files}
INSTALLED=$FILES_DIR/.openkb-installed
INSTALLING=$FILES_DIR/.openkb-installing
HOLDING=/run/openkb/.openkb-holding
DRUSH="php -d memory_limit=512M ./vendor/drush/drush/drush.php"

exec 9> "$FILES_DIR/.openkb-boot.lock" || exit 1

# BusyBox flock has no -w, so the wait is bounded here: ten minutes covers an
# install running in the container that holds the lock.
waited=0
until flock -n 9; do
  if [ "$waited" -ge 600 ]; then
    echo "openkb-boot: ANOTHER CONTAINER HAS HELD THE BOOT LOCK FOR TEN MINUTES." >&2
    echo "openkb-boot: nothing was installed and the setup page stays up. Check the other" >&2
    echo "openkb-boot: container's log, or start over with 'docker compose down -v'." >&2
    exit 1
  fi
  waited=$((waited + 5))
  sleep 5
done

: > "$HOLDING"

if [ ! -f "$INSTALLED" ]; then
  # The database decides, never the bootstrap: a site whose bootstrap fails for
  # a transient reason still holds its data, and site-install.sh begins by
  # dropping the database.
  if ! TABLES=$($DRUSH sql:query "SHOW TABLES" 2>&1); then
    echo "openkb-boot: THE DATABASE DID NOT ANSWER, so this boot cannot tell an empty" >&2
    echo "openkb-boot: database from a site of its own and installs nothing. The database" >&2
    echo "openkb-boot: has to exist and be reachable with the credentials in the" >&2
    echo "openkb-boot: environment. The setup page stays up; drush said:" >&2
    echo "$TABLES" >&2
    exit 1
  fi
  if [ -n "$TABLES" ] && [ ! -f "$INSTALLING" ]; then
    echo "openkb-boot: THIS DATABASE IS NOT EMPTY, BUT NO OPENKB INSTALL FINISHED ON IT." >&2
    echo "openkb-boot: nothing is installed over it and the setup page stays up. Then" >&2
    echo "openkb-boot: restart the drupal service after one of these:" >&2
    echo "openkb-boot:  - the site was installed and works: write the marker with" >&2
    echo "openkb-boot:      docker compose exec drupal openkb-update" >&2
    echo "openkb-boot:  - reinstall, which DESTROYS the site's content:" >&2
    echo "openkb-boot:      docker compose exec drupal openkb-install" >&2
    echo "openkb-boot:  - empty the database, and the boot installs the site." >&2
    exit 1
  fi
  if [ -n "$TABLES" ]; then
    echo "openkb-boot: an earlier install did not finish, installing over it."
  else
    echo "openkb-boot: no site on this database, installing it."
  fi
  if ! ./scripts/site-install.sh; then
    echo "openkb-boot: THE INSTALL FAILED — the output above says why." >&2
    echo "openkb-boot: the stack keeps answering with the setup page. Fix the cause and" >&2
    echo "openkb-boot: restart the drupal service, or start over with 'docker compose down -v'." >&2
    exit 1
  fi
fi

# openkb_update_hold sets the hold, and the cache rebuild update.php ends with
# lifts it again.
$DRUSH openkb:update-hold || echo "openkb-boot: could not check for pending database updates." >&2

rm -f "$HOLDING"
echo "openkb-boot: the site is up."
