 * site-level settings.php sources it last.
 *
 * Examples:
 * - $settings['hash_salt'] = '...';
 * - $config['ai_provider_openai.settings']['api_key'] = '...';
 * - $databases['default']['default']['host'] = '127.0.0.1';
 */
